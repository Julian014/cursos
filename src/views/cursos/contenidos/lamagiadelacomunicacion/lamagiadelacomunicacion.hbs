<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Curso Profesional</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />
<style>
  :root {
    --primary: #4f46e5;
    --secondary: #f3f4f6;
    --accent: #10b981;
    --danger: #ef4444;
    --text-dark: #1f2937;
    --text-light: #ffffff;
    --card-bg: #ffffff;
    --border-radius: 16px;
    --shadow: 0 6px 30px rgba(0, 0, 0, 0.07);
  }


  h1 {
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--primary);
    text-align: center;
  }

  #menuModulos {
    background: var(--card-bg);
    padding: 2rem;
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    width: 100%;
    max-width: 1000px;
    margin-bottom: 2.5rem;
  }

  #menuModulos ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    list-style: none;
  }

  #menuModulos button {
    background-color: var(--primary);
    color: var(--text-light);
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
  }

  #menuModulos button:hover {
    background-color: #4338ca;
    transform: translateY(-2px);
  }

  #menuModulos button:disabled {
    background: #d1d5db;
    color: #6b7280;
    box-shadow: none;
    cursor: not-allowed;
  }

  .modulo-slide {
    background: var(--card-bg);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow);
    padding: 2rem;
    max-width: 1000px;
    width: 100%;
    position: relative;
    overflow: hidden;
    animation: fadeIn 0.5s ease-in-out;
  }

  .paso {
    display: none;
    text-align: center;
  }

  .paso.activo {
    display: block;
  }

  .paso img,
  .paso video {
    max-width: 100%;
    border-radius: 14px;
    margin-top: 1.5rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .controles {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .controles button {
    padding: 0.9rem 1.6rem;
    background-color: var(--accent);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 500;
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .controles button:hover {
    background-color: #059669;
    transform: scale(1.05);
  }

  .controles button:disabled {
    background-color: #d1fae5;
    color: #047857;
    cursor: not-allowed;
  }

  .evaluacion {
    margin-top: 2.5rem;
    background: var(--secondary);
    padding: 2rem;
    border-radius: 16px;
    border: 2px dashed var(--primary);
  }

  .evaluacion h2 {
    margin-bottom: 1rem;
  }

  .evaluacion button {
    margin: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: none;
    background-color: var(--primary);
    color: white;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .evaluacion button:hover {
    background-color: #4338ca;
  }

  /* Barra de progreso */
  .barra-progreso {
    height: 10px;
    width: 100%;
    background-color: #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .barra-progreso .progreso {
    height: 100%;
    background-color: var(--accent);
    width: 0%;
    transition: width 0.4s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .modulo-slide {
      padding: 1.2rem;
    }

    .controles {
      flex-direction: column;
      gap: 0.75rem;
    }

    #menuModulos ul {
      flex-direction: column;
      align-items: center;
    }
  }
  .indicadores {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 1.5rem;
}

.indicadores .circulo {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background-color: #d1d5db;
  transition: background-color 0.3s ease;
}

.indicadores .circulo.activo {
  background-color: var(--primary);
}
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
}
html, body {
  overflow-x: hidden;
}
* {
  box-sizing: border-box;
  max-width: 100%;
}
.btn-lightbox-nav {
  padding: 0.6rem 1.2rem;
  border: none;
  background-color: #2563eb;
  color: white;
  border-radius: 8px;
  font-size: 0.95rem;
  cursor: pointer;
  transition: background 0.2s ease;
}
.btn-lightbox-nav:hover {
  background-color: #1d4ed8;
}

</style>

