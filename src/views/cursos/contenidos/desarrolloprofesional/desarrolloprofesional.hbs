<button id="btnSiguiente4" onclick="siguientePaso()">Siguiente</button>
  </div>
</div>

  <script>
    let moduloActual = 1;
    let pasoActual = 0;

function irAModulo(n) {
  document.querySelectorAll("[id^='modulo']").forEach(m => m.style.display = 'none');
  document.getElementById(`modulo${n}`).style.display = 'block';
  moduloActual = n;
  pasoActual = 0;
  actualizarPaso();
  
  // Resetear el texto del botón a "Siguiente" cuando se cambia de módulo
  document.getElementById(`btnSiguiente${n}`).textContent = 'Siguiente';
}

    function actualizarPaso() {
      const pasos = document.querySelectorAll(`#modulo${moduloActual} .paso`);
      pasos.forEach(p => p.classList.remove('activo'));
      if (pasoActual < pasos.length) {
        pasos[pasoActual].classList.add('activo');
      }
    }
function siguientePaso() {
  const pasos = document.querySelectorAll(`#modulo${moduloActual} .paso`);
  if (pasoActual < pasos.length - 1) {
    pasoActual++;
    actualizarPaso();
    
    // Verificar si estamos en el último paso del módulo 4
    if (moduloActual === 4 && pasoActual === pasos.length - 1) {
      document.getElementById(`btnSiguiente${moduloActual}`).textContent = 'Finalizar';
    }
  } else if (moduloActual === 4 && pasoActual === pasos.length - 1) {
    // Aquí puedes agregar lógica para cuando se finaliza el curso
    alert('¡Curso completado con éxito!');
    // O redirigir a otra página, etc.
  }
}
    function anteriorPaso() {
      if (pasoActual > 0) {
        pasoActual--;
        actualizarPaso();
      }
    }

    function responderEvaluacion(btn, correcta) {
      if (correcta) {
        const pasoFinal = document.getElementById(`videoFinalPaso${moduloActual}`);
        if (pasoFinal) {
          pasoFinal.style.display = 'block';
        }
        siguientePaso();
      } else {
        alert('Respuesta incorrecta. Intenta de nuevo.');
      }
    }

    function completarModulo(modulo) {
      localStorage.setItem(`modulo${modulo}Completado`, 'true');
      irAModulo(modulo + 1);
    }

    // Mostrar el primer módulo por defecto
    window.onload = () => {
      irAModulo(1);
    };
  </script>


