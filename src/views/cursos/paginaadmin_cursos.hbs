<style>
  .curso-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 20px;
    background-color: #fdfdfd;
  }

  .curso-card:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 25px rgba(0, 0, 0, 0.1);
  }

  .curso-icon {
    background-color: #4f46e5; /* Indigo */
    width: 50px;
    height: 50px;
    font-size: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-outline-primary {
    border-radius: 12px;
    font-weight: 500;
  }

  .btn-success {
    border-radius: 12px;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.4rem;
  }

  .card-text {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .curso-card {
      margin-top: 1rem;
    }
  }
</style>


<div class="container mt-5">
  <h2 class="mb-4 text-center text-primary">🎓 Bienvenido, {{name}}</h2>

  <div class="row justify-content-center">

