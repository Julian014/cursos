<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Consulta de Pagos por Curso</h2>
    <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#formAgregarPago" aria-expanded="false" aria-controls="formAgregarPago">
      <i class="bi bi-plus-lg"></i> Agregar Pago
    </button>
  </div>

  <!-- Formulario colapsable -->
  <div class="collapse mb-4" id="formAgregarPago">
    <div class="card card-body">
      <form id="pagoForm" action="/pagos_nuevo" method="POST">
        <div class="row mb-3">
          <div class="col-md-6">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" id="nombre" name="nombre" class="form-control" required minlength="2">
          </div>
          <div class="col-md-6">
            <label for="apellidos" class="form-label">Apellidos</label>
            <input type="text" id="apellidos" name="apellidos" class="form-control" required minlength="2">
          </div>
        </div>




<div class="row mb-3">
  <div class="col-md-6">
    <label for="tipo_documento" class="form-label">Tipo de Documento</label>
    <select id="tipo_documento" name="tipo_documento" class="form-select" required>
      <option value="">Seleccione...</option>
      <option value="CC">Cédula de Ciudadanía</option>
      <option value="TI">Tarjeta de Identidad</option>
      <option value="CE">Cédula de Extranjería</option>
      <option value="PP">Pasaporte</option>
    </select>
  </div>
  <div class="col-md-6">
    <label for="numero_documento" class="form-label">Número de Documento</label>
    <input type="text" id="numero_documento" name="numero_documento" class="form-control" required minlength="5">
  </div>
</div>


        <div class="mb-3">
          <label for="correo" class="form-label">Correo</label>
          <input type="email" id="correo" name="correo" class="form-control" required>
        </div>



        <hr>
        <h5>Cursos</h5>

        <div id="cursos-container">
          <div class="curso-item border p-3 mb-3 rounded bg-light">
            <div class="mb-3">
              <label class="form-label">Curso</label>
              <input type="text" name="cursos[0][nombre_curso]" class="form-control nombre-curso" required minlength="3">
            </div>
            <div class="row mb-3">
              <div class="col-md-4">
                <label class="form-label">Total Curso ($)</label>
                <input type="number" step="0.01" min="0.01" name="cursos[0][total_curso]" class="form-control total" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">Abono ($)</label>
                <input type="number" step="0.01" min="0" name="cursos[0][abono]" class="form-control abono" required>
              </div>
              <div class="col-md-4">
                <label class="form-label">Saldo Pendiente ($)</label>
                <input type="number" step="0.01" class="form-control saldo_pendiente" readonly>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Fecha de Pago</label>
              <input type="date" name="cursos[0][fecha_pago]" class="form-control fecha-pago" required>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm eliminar-curso" style="display: none;">
              <i class="bi bi-trash"></i> Eliminar
            </button>
          </div>
        </div>

        <button type="button" class="btn btn-outline-primary mb-3" id="agregarCurso">
          <i class="bi bi-plus-circle"></i> Agregar Otro Curso
        </button>

        <div class="mt-3">
          <button type="submit" class="btn btn-primary" id="submitBtn">Guardar Pago</button>
          <button type="button" class="btn btn-secondary ms-2" data-bs-toggle="collapse" data-bs-target="#formAgregarPago">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Tabla de pagos -->
  {{#if pagos.length}}
    <table class="table table-striped mt-3">
<thead>
  <tr>
    <th><input type="text" class="form-control form-control-sm" placeholder="Nombre"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Apellidos"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Tipo Doc."></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Nro. Doc."></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Correo"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Curso"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Total"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Fecha"></th>
    <th><input type="text" class="form-control form-control-sm" placeholder="Saldo"></th>
  </tr>
</thead>

      <tbody>
        {{#each pagos}}
          <tr>
            <td>{{this.nombre}}</td>
            <td>{{this.apellidos}}</td>
            <td>{{this.tipo_documento}}</td>
            <td>{{this.numero_documento}}</td>
            <td>{{this.correo}}</td>
            <td>{{this.nombre_curso}}</td>
            <td>${{this.total_curso}}</td>
            <td>{{formatDate this.fecha_pago}}</td>
            <td>${{this.saldo_pendiente}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <div class="alert alert-info mt-3">
      No se encontraron registros de pagos.
    </div>
  {{/if}}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('cursos-container');
    const agregarBtn = document.getElementById('agregarCurso');
    const pagoForm = document.getElementById('pagoForm');
    const submitBtn = document.getElementById('submitBtn');

    function calcularSaldo(item) {
      const total = parseFloat(item.querySelector('.total').value) || 0;
      const abono = parseFloat(item.querySelector('.abono').value) || 0;
      const saldo = total - abono;
      item.querySelector('.saldo_pendiente').value = saldo.toFixed(2);

      const abonoInput = item.querySelector('.abono');
      if (abono > total) {
        abonoInput.classList.add('is-invalid');
      } else {
        abonoInput.classList.remove('is-invalid');
      }
    }

    function actualizarIndices() {
      const items = container.querySelectorAll('.curso-item');
      items.forEach((item, index) => {
        item.querySelectorAll('input').forEach(input => {
          if (input.name) {
            input.name = input.name.replace(/\[\d+\]/, `[${index}]`);
          }
        });
        const eliminarBtn = item.querySelector('.eliminar-curso');
        eliminarBtn.style.display = items.length > 1 ? 'block' : 'none';
      });
    }

    container.addEventListener('input', (e) => {
      if (e.target.classList.contains('total') || e.target.classList.contains('abono')) {
        calcularSaldo(e.target.closest('.curso-item'));
      }
    });

    container.addEventListener('click', (e) => {
      if (e.target.closest('.eliminar-curso')) {
        e.target.closest('.curso-item').remove();
        actualizarIndices();
      }
    });

    agregarBtn.addEventListener('click', () => {
      const items = container.querySelectorAll('.curso-item');
      const lastItem = items[items.length - 1];
      const clone = lastItem.cloneNode(true);

      clone.querySelectorAll('input').forEach(input => {
        input.value = '';
        input.classList.remove('is-invalid');
        if (input.classList.contains('saldo_pendiente')) input.value = '0.00';
      });

      container.appendChild(clone);
      actualizarIndices();
    });

    pagoForm.addEventListener('submit', (e) => {
      let isValid = true;
      container.querySelectorAll('.curso-item').forEach(item => {
        const total = parseFloat(item.querySelector('.total').value) || 0;
        const abono = parseFloat(item.querySelector('.abono').value) || 0;

        if (abono > total) {
          item.querySelector('.abono').classList.add('is-invalid');
          isValid = false;
        }
      });

      if (!isValid) {
        e.preventDefault();
        alert('El abono no puede ser mayor que el total del curso en ninguno de los cursos.');
      } else {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Procesando...';
      }
    });

    actualizarIndices();
    container.querySelectorAll('.curso-item').forEach(calcularSaldo);
  });
</script>

<style>
  .is-invalid {
    border-color: #dc3545;
  }
  .is-invalid:focus {
    box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const table = document.querySelector("table");
    const filters = table.querySelectorAll("thead input");
    const rows = table.querySelectorAll("tbody tr");

    filters.forEach((input, colIndex) => {
      input.addEventListener("input", () => {
        const filterValues = Array.from(filters).map(f => f.value.toLowerCase());
        
        rows.forEach(row => {
          const cells = row.querySelectorAll("td");
          const match = filterValues.every((val, i) => {
            return cells[i].textContent.toLowerCase().includes(val);
          });

          row.style.display = match ? "" : "none";
        });
      });
    });
  });
</script>
