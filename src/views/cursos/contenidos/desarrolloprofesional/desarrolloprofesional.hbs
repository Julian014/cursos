<div id="modulo4">
  <h2>Módulo 4: [Título aquí]</h2>
  <div class="modulo-slide">
<div class="paso activo">
      <img src="material_cursos/curso_desarrolloprofesional/Modulo1-1.png" alt="Imagen 1">
    </div>
    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-2.png" alt="Imagen 2"></div>
