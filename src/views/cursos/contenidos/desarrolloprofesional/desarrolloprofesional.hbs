<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Curso: Desarrollo Profesional</title>
<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(to right, #f7f9fc, #e3ebf6);
    color: #333;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    min-height: 100vh;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #2c3e50;
  }

  h2 {
    font-size: 2rem;
    margin: 1.5rem 0;
    color: #34495e;
  }

  h3, h4 {
    margin: 1rem 0;
    color: #2c3e50;
  }

  #menuModulos {
    background: white;
    padding: 1rem 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    margin-bottom: 2rem;
  }

  #menuModulos ul {
    list-style: none;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  #menuModulos button {
    background: #3498db;
    color: white;
    padding: 0.6rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.3s ease;
  }

  #menuModulos button:hover {
    background: #2980b9;
  }

  .modulo-slide {
    width: 100%;
    max-width: 960px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    position: relative;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    padding: 1rem;
    margin: auto;
  }

  .paso {
    display: none;
    width: 100%;
    height: auto;
    text-align: center;
  }

  .paso.activo {
    display: block;
  }

  .paso img,
  .paso video {
    max-width: 100%;
    max-height: 80vh;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  .controles {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .controles button {
    padding: 0.7rem 1.2rem;
    font-size: 1rem;
    background: #2ecc71;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .controles button:hover {
    background: #27ae60;
  }

  .evaluacion {
    padding: 2rem;
    background: #ecf0f1;
    border-radius: 10px;
    box-shadow: inset 0 2px 8px rgba(0,0,0,0.05);
  }

  .evaluacion button {
    margin: 0.5rem;
    background: #e67e22;
    color: white;
    padding: 0.6rem 1rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .evaluacion button:hover {
    background: #d35400;
  }

  #modulo1, #modulo2, #modulo3, #modulo4 {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
</style>

</head>
<body>

