    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-10.png" alt="Imagen 10"></div>
    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-11.png" alt="Imagen 11"></div>
    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-12.png" alt="Imagen 12"></div>
    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-13.png" alt="Imagen 13"></div>
    <div class="paso"><img src="material_cursos/curso_desarrolloprofesional/modulo1-14.png" alt="Imagen 14"></div>

    <div class="paso">
