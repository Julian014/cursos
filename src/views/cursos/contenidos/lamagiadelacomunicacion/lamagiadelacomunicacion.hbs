<script>
  function borrarDatosPrueba() {
    // Confirmar antes de borrar
    if(confirm('¿Estás seguro que quieres borrar TODOS los datos de progreso?\nEsta acción no se puede deshacer.')) {
      // Borrar todos los datos de módulos completados
      for(let i = 1; i <= 4; i++) {
        localStorage.removeItem(`modulo${i}Completado`);
      }
      
      // Deshabilitar todos los módulos excepto el primero
      document.getElementById('btnModulo2').disabled = true;
      document.getElementById('btnModulo3').disabled = true;
      document.getElementById('btnModulo4').disabled = true;
      
      // Volver al módulo 1
      irAModulo(1);
      
      alert('Todos los datos de progreso han sido borrados. Vuelve al Módulo 1.');
    }
  }
</script>




<script>
// Variables globales
let pasoActual = 0;
let moduloActivo = 1;
let pasos = [];
let indicadores = null;
let evaluacionAprobada = false;

function inicializarModulo(num) {
    moduloActivo = num;
    evaluacionAprobada = false; // Resetear estado de evaluación al cambiar de módulo
    const modulo = document.querySelector(`#modulo${num}`);
    pasos = modulo.querySelectorAll('.paso');
    indicadores = document.getElementById(`indicadoresModulo${num}`);
    
    // Reiniciar paso actual
    pasoActual = 0;
    
    // Ocultar el video final si está visible
    const videoFinal = modulo.querySelector(`#videoFinalPaso${num}`);
    if(videoFinal) {
        videoFinal.style.display = 'none';
        videoFinal.classList.remove('activo');
    }
    
    // Mostrar solo el primer paso
    pasos.forEach((paso, index) => {
        if(index === 0) {
            paso.style.display = 'block';
            paso.classList.add('activo');
        } else {
            paso.style.display = 'none';
            paso.classList.remove('activo');
        }
    });
    
    // Crear círculos indicadores dinámicamente si no existen
    if (indicadores && indicadores.children.length === 0) {
        pasos.forEach((_, index) => {
            // No crear indicador para el video final
            if(!pasos[index].id || !pasos[index].id.includes('videoFinalPaso')) {
                const circulo = document.createElement('div');
                circulo.classList.add('circulo');
                if (index === 0) circulo.classList.add('activo');
                indicadores.appendChild(circulo);
            }
        });
    }
    
    // Actualizar controles e indicadores
    actualizarControles();
    actualizarIndicadores();
}

function actualizarIndicadores() {
    if (!indicadores) return;
    
    const circulos = indicadores.querySelectorAll('.circulo');
    circulos.forEach((circulo, index) => {
        circulo.classList.toggle('activo', index === pasoActual);
    });
}

function mostrarPaso(index) {
    if(index < 0 || index >= pasos.length) return;
    
    // Ocultar todos los pasos
    pasos.forEach(paso => {
        paso.style.display = 'none';
        paso.classList.remove('activo');
    });
    
    // Mostrar el paso actual
    pasos[index].style.display = 'block';
    pasos[index].classList.add('activo');
    pasoActual = index;
    
    // Actualizar controles e indicadores
    actualizarControles();
    actualizarIndicadores();
}

function actualizarControles() {
    const btnAnterior = document.querySelector(`#modulo${moduloActivo} .controles button:first-child`);
    const btnSiguiente = document.querySelector(`#modulo${moduloActivo} .controles button:last-child`);
    
    if(btnAnterior) btnAnterior.disabled = pasoActual === 0;
    
    if(btnSiguiente) {
        const esVideoFinal = pasos[pasoActual].id?.includes('videoFinalPaso');
        const esEvaluacion = pasos[pasoActual].querySelector('.evaluacion') !== null;
        
        btnSiguiente.disabled = pasoActual >= pasos.length - 1 || esVideoFinal || 
                              (esEvaluacion && !evaluacionAprobada);
    }
}

function siguientePaso() {
    if (pasoActual < pasos.length - 1) {
        mostrarPaso(pasoActual + 1);
    }
}

function anteriorPaso() {
    if (pasoActual > 0) {
        mostrarPaso(pasoActual - 1);
    }
}

function responderEvaluacion(btn, correcto) {
    if (correcto) {
        evaluacionAprobada = true;
        const moduloActual = btn.closest('[id^="modulo"]').id.replace('modulo', '');
        
        // Ocultar evaluación
        btn.closest('.paso').style.display = 'none';
        
        // Mostrar video final
        const videoFinal = document.getElementById(`videoFinalPaso${moduloActual}`);
        if(videoFinal) {
            videoFinal.style.display = 'block';
            videoFinal.classList.add('activo');
        }
        
        // Actualizar controles
        actualizarControles();
        
        // Marcar módulo como completado
        localStorage.setItem(`modulo${moduloActual}Completado`, 'true');
    } else {
        alert('Respuesta incorrecta, intenta de nuevo');
    }
}

function completarModulo(num) {
    if (!evaluacionAprobada) {
        alert('Debes completar la evaluación correctamente antes de pasar al siguiente módulo');
        return;
    }
    
    if (num < 4) {
        document.getElementById(`btnModulo${num + 1}`).disabled = false;
        irAModulo(num + 1);
    }
    
    localStorage.setItem(`modulo${num}Completado`, 'true');
    evaluacionAprobada = false;
}

function irAModulo(num) {
    document.querySelectorAll('[id^="modulo"]').forEach(m => m.style.display = 'none');
    const modulo = document.getElementById(`modulo${num}`);
    if(modulo) {
        modulo.style.display = 'block';
        modulo.scrollIntoView({ behavior: 'smooth' });
        inicializarModulo(num);
    }
}

// Inicialización
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[id^="modulo"]').forEach((m, i) => {
        m.style.display = i === 0 ? 'block' : 'none';
    });
    
    inicializarModulo(1);
    
    // Habilitar módulos completados
    for (let i = 1; i <= 4; i++) {
        if (localStorage.getItem(`modulo${i}Completado`) === 'true') {
            document.getElementById(`btnModulo${i + 1}`)?.removeAttribute('disabled');
        }
    }
});




function finalizarCurso() {
  const curso = window.location.pathname;

  console.log("📤 Enviando finalización de curso:", curso);

  fetch('/registrar_curso_aprobado', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ curso })
  })
  .then(res => res.json())
.then(data => {
  console.log('✅ Curso registrado en BD:', data);
  // Redirigir al certificado automáticamente
  window.location.href = `/certificado?curso=${encodeURIComponent(window.location.pathname)}`;
})

  .catch(err => {
    console.error('❌ Error al registrar curso:', err);
    alert('Ocurrió un error al registrar el curso. Intenta nuevamente.');
  });
}

</script>















  <script>
function actualizarPaso() {
  const pasos = document.querySelectorAll(`#modulo${moduloActual} .paso`);
  pasos.forEach(p => p.classList.remove('activo'));
  if (pasoActual < pasos.length) {
    pasos[pasoActual].classList.add('activo');

    // Indicadores
    actualizarIndicadores(); // <-- Añadido aquí

    // Ocultar el botón "Siguiente" si estamos en la evaluación y no está aprobada
    const esEvaluacion = pasos[pasoActual].querySelector('.evaluacion') !== null;
    if (esEvaluacion && !evaluacionAprobada) {
      document.getElementById(`btnSiguiente${moduloActual}`).style.display = 'none';
    } else {
      document.getElementById(`btnSiguiente${moduloActual}`).style.display = 'block';
    }
  }
}


  </script>
<script>
  function toggleMenuModulos() {
    const menu = document.getElementById('menuModulos');
    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
  }
</script>

<script>


function abrirLightbox(index) {
  const modulo = document.querySelector(`#modulo${moduloActivo}`);
  pasos = modulo.querySelectorAll('.paso');
  pasoActual = index;

  const pasoOriginal = pasos[pasoActual];

  // 🛑 Si es una evaluación, salir del lightbox y mostrar en modo normal
  const esEvaluacion = pasoOriginal.querySelector('.evaluacion') !== null;
  if (esEvaluacion) {
    cerrarLightbox();
    mostrarPaso(pasoActual);
    alert('La evaluación debe completarse fuera del modo pantalla completa.');
    return;
  }

  const contenedor = document.getElementById("lightbox-content");

  // 🧹 Limpia el contenido anterior
  while (contenedor.firstChild) {
    const video = contenedor.firstChild.querySelector?.('video');
    if (video) {
      video.pause();
      video.src = "";
      video.load();
    }
    contenedor.removeChild(contenedor.firstChild);
  }

  const pasoClonado = pasoOriginal.cloneNode(true);
  pasoClonado.style.display = "block";
  pasoClonado.classList.add("activo");

  const video = pasoClonado.querySelector('video');
  if (video) {
    video.setAttribute('controls', 'true');
    video.play();
  }

  contenedor.appendChild(pasoClonado);
  document.getElementById("lightbox").style.display = "flex";
}






function cerrarLightbox() {
  document.getElementById("lightbox").style.display = "none";

  // Mostrar en la vista normal el paso actual
  mostrarPaso(pasoActual);
}

function cambiarPaso(direccion) {
  const modulo = document.querySelector(`#modulo${moduloActivo}`);
  pasos = modulo.querySelectorAll('.paso');

  const nuevoPaso = pasoActual + direccion;

  if (nuevoPaso >= 0 && nuevoPaso < pasos.length) {
    pasoActual = nuevoPaso;
    abrirLightbox(pasoActual);
  }
}



document.querySelectorAll('[id^="modulo"] .paso img, [id^="modulo"] .paso video').forEach((elemento, index) => {
  elemento.style.cursor = "pointer";
  elemento.addEventListener("click", () => {
    const modulo = elemento.closest('[id^="modulo"]');
    const num = parseInt(modulo.id.replace("modulo", ""));
    moduloActivo = num;

    pasos = modulo.querySelectorAll('.paso');
    const indexPaso = Array.from(pasos).indexOf(elemento.closest('.paso'));
    abrirLightbox(indexPaso);
  });
});
document.addEventListener('keydown', function(event) {
  if (event.key === "Escape") {
    cerrarLightbox();
  }
});


</script>

</body>
