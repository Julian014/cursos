<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Certificado</title>
  <style>
    body {
      font-family: 'Georgia', serif;
      background: #fdfdfd;
      text-align: center;
      padding: 50px;
    }

    .certificado {
      border: 5px solid #2c3e50;
      padding: 50px;
      max-width: 800px;
      margin: auto;
      background: white;
    }

    h1 {
      font-size: 2.5em;
      margin-bottom: 0.5em;
      color: #2c3e50;
    }

    h2 {
      font-size: 1.5em;
      color: #34495e;
    }

    p {
      font-size: 1.2em;
      margin-top: 2em;
    }
  </style>
</head>
<body>
  <div class="certificado">
    <h1>Certificado de Finalización</h1>
    <h2>{{usuario}}</h2>
    <p>Ha completado satisfactoriamente el curso:</p>
    <h2><em>{{curso}}</em></h2>
    <p>Fecha de aprobación: <strong>{{fecha}}</strong></p>
  </div>
</body>
</html>
